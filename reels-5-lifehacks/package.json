{
  "name": "reels-5-lifehacks",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Reels5Lifehacks out/reels_raw.mp4 && npm run master",
    "stills": "node scripts/stills.mjs",
    "typecheck": "tsc",
    "setup-voice": "bash scripts/setup-voice.sh",
    "voice": "tsx scripts/make-voice.ts",
    "sfx": "python3 scripts/build-sfx.py",
    "master": "remotion ffmpeg -y -v error -i out/reels_raw.mp4 -c:v copy -af loudnorm=I=-14:TP=-1.5:LRA=11 -ar 48000 -c:a aac -b:a 192k -t 60 -movflags +faststart out/reels_5_lifehacks.mp4"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@remotion/bundler": "^4.0.543",
    "@remotion/cli": "^4.0.543",
    "@remotion/google-fonts": "^4.0.543",
    "@remotion/renderer": "^4.0.543",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.543"
  },
  "private": true,
  "devDependencies": {
    "@types/react": "^18.3.31",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
